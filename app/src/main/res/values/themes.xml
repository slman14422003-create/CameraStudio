<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="cAccent">@color/accent</item>
        <item name="cAccentText">@color/accent_text</item>
        <item name="cAccentSoft">@color/accent_soft</item>
        <item name="cBrandStart">@color/brand_start</item>
        <item name="cBrandMid">@color/brand_mid</item>
        <item name="cBrandEnd">@color/brand_end</item>
        <item name="cBg">@color/bg</item>
        <item name="cGroupBg">@color/bg_group</item>
        <item name="cSurface">@color/surface</item>
        <item name="cSurfaceHigh">@color/surface_high</item>
        <item name="cField">@color/field</item>
        <item name="cStroke">@color/stroke</item>
        <item name="cStrokeSoft">@color/stroke_soft</item>
        <item name="cTextPrimary">@color/text_primary</item>
        <item name="cTextSecondary">@color/text_secondary</item>
        <item name="cTextHint">@color/text_hint</item>
        <item name="cNeutralSoft">@color/neutral_soft</item>
        <item name="colorPrimary">?attr/cAccent</item>
        <item name="colorPrimaryDark">?attr/cBg</item>
        <item name="colorAccent">?attr/cAccentText</item>
        <item name="android:windowBackground">?attr/cBg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">?attr/cBg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:textColorPrimary">?attr/cTextPrimary</item>
        <item name="android:textColorSecondary">?attr/cTextSecondary</item>
        <item name="android:textColorHint">?attr/cTextHint</item>
        <item name="alertDialogTheme">@style/AppDialog</item>
        <item name="android:colorBackground">?attr/cBg</item>
        <item name="colorControlNormal">?attr/cTextSecondary</item>
        <item name="colorControlActivated">?attr/cAccentText</item>
        <item name="android:textColorLink">?attr/cAccentText</item>
        <item name="android:windowAnimationStyle">@style/ActivityAnim</item>
        <item name="android:seekBarStyle">@style/IosSeekBar</item>
        <item name="seekBarStyle">@style/IosSeekBar</item>
    </style>

    <!-- one slider look everywhere (editors, player, settings): thin track, white iOS knob -->
    <style name="IosSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="ActivityAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/act_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/act_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/act_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/act_close_exit</item>
    </style>

    <style name="AppDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">?attr/cAccentText</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">?attr/cTextPrimary</item>
        <item name="android:textColorSecondary">?attr/cTextSecondary</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@style/DialogAnim</item>
        <item name="windowMinWidthMinor">92%</item>
        <item name="windowMinWidthMajor">60%</item>
        <item name="android:windowElevation">0dp</item>
    </style>

    <style name="DialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dlg_in</item>
        <item name="android:windowExitAnimation">@anim/dlg_out</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:tint">?attr/cTextPrimary</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/anim_splash</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
