<?xml version="1.0" encoding="utf-8"?>
<!-- iOS alert: starts slightly large and settles in -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <alpha android:duration="200" android:fromAlpha="0" android:toAlpha="1" />
    <scale
        android:duration="320"
        android:fromXScale="1.12"
        android:fromYScale="1.12"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
