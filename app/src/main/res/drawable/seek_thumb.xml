<?xml version="1.0" encoding="utf-8"?>
<!-- iOS slider knob: white disc with a soft hairline shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#26000000" />
            <size android:width="28dp" android:height="28dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
            <size android:width="28dp" android:height="28dp" />
        </shape>
    </item>
</layer-list>
